{
  "name": "@passness/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:harness": "vitest run --config vitest.e2e.config.ts src/e2e/stripe-checkout-harness.test.ts",
    "test:fast": "vitest run --passWithNoTests --exclude '**/*.integration.test.ts' --exclude 'src/e2e/**' --exclude 'src/app/api/cron/**' --exclude 'src/app/actions/catalog.test.ts' --exclude 'src/app/actions/connected-accounts.test.ts' --exclude 'src/app/actions/fulfillment.test.ts' --exclude 'src/app/actions/payments.test.ts'",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1103.0",
    "@passness/config": "workspace:*",
    "@passness/contracts": "workspace:*",
    "@passness/core": "workspace:*",
    "@passness/database": "workspace:*",
    "@passness/intelligence": "workspace:*",
    "@passness/ui": "workspace:*",
    "@stripe/connect-js": "^3.4.6",
    "@stripe/react-connect-js": "^3.4.4",
    "@stripe/react-stripe-js": "3.10.0",
    "@stripe/stripe-js": "5.10.0",
    "@vercel/functions": "^3.10.6",
    "@vercel/speed-insights": "^2.1.0",
    "better-auth": "^1.7.17",
    "drizzle-orm": "^0.36.0",
    "lenis": "^1.3.26",
    "maplibre-gl": "5.6.2",
    "next": "^16.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^6.18.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "postgres": "^3.4.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
